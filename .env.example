# Copy to .env and fill in. Never commit .env.
HAI_API_KEY=
DEVIN_API_KEY=
DEVIN_ORG_ID=
GLADIA_API_KEY=
LINKUP_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
HAI_BASE_URL=https://agp.hcompany.ai
# Optional: comma-separated regions the tester may use (fallback order after HAI_BASE_URL)
# HAI_REGIONS=https://agp.hcompany.ai
# Dashboard API (T14): set a token for any deployment reachable from outside the laptop
# P2_CONTROL_TOKEN=
# P2_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# QA start state for free play: tough (default: 999 health, damage still works), god or off
P2_GOD=tough
# H model for the tester (default holo4-35b-a3b, H's fastest; holo4-27b to compare)
P2_TESTER_MODEL=
