# Copy to .env and fill in. Never commit .env.
HAI_API_KEY=
DEVIN_API_KEY=
DEVIN_ORG_ID=
GLADIA_API_KEY=
# voice.listen languages (comma list); en+fr enables code switching, less accurate live
P2_VOICE_LANGS=en
ELEVENLABS_API_KEY=
# kid mode voice: 1 = ElevenLabs streaming into ffplay (default), 0 = whole mp3 then play
P2_KID_STREAM=1
# kid mode voice (ElevenLabs voice id); default: premade "Chris" (team pick); pick by ear: python -m voice.commentator --try-voices
P2_KID_VOICE=
# kid mode ElevenLabs model; default eleven_v3 (laughs/sighs); eleven_multilingual_v2 / eleven_turbo_v2_5 are faster
P2_KID_TTS_MODEL=
# kid mode in the browser (voice.kid_web): Freedoom WAD path and demo budget caps
P2_KID_WAD=
P2_KID_MAX_LINES=4000
P2_KID_MAX_SAYS=2000
P2_KID_MAX_LISTENS=600
LINKUP_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
HAI_BASE_URL=https://agp.hcompany.ai
# Optional: comma-separated regions the tester may use (fallback order after HAI_BASE_URL)
# HAI_REGIONS=https://agp.hcompany.ai
# Dashboard API (T14): set a token for any deployment reachable from outside the laptop
# P2_CONTROL_TOKEN=
# P2_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# QA start state for free play: tough (default: 999 health, damage still works), god or off
P2_GOD=tough
# QA start preset (launcher PRESETS), e.g. stage-kb3: E3M1 + a spawned invulnerability sphere
P2_PRESET=
# windowed game size at the top-left corner (P2_FULLSCREEN unset): dashboard on the right
P2_WINDOW=1066x800
# H model for the tester (default holo4-35b-a3b, H's fastest; holo4-27b to compare)
P2_TESTER_MODEL=
# autopilot: a verified bug goes to Devin without a spoken "yes" (Skip still cancels)
# P2_AUTO_FIX=1
# replay an earlier Devin fix at once instead of waiting for a new one (shown as cached on the dashboard)
# P2_CACHED_FIX_BUG=KB3
# P2_CACHED_FIX_EXE=C:\path\to\recordings\<run>\fix\build\chocolate-doom.exe
# P2_CACHED_FIX_PR=https://github.com/kaktamsdengami/chocolate-doom/pull/5
# P2_CACHED_FIX_DEVIN=
