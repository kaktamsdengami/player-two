# Copy to .env and fill in. Never commit .env.
HAI_API_KEY=
DEVIN_API_KEY=
DEVIN_ORG_ID=
GLADIA_API_KEY=
LINKUP_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
HAI_BASE_URL=https://agp.hcompany.ai
